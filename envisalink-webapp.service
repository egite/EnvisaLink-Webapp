# systemd unit to run the EnvisaLink webapp at boot.
# Set User, WorkingDirectory and ExecStart below to your user and checkout, and
# run ./run.sh once first so the venv exists. Then:
#   sudo cp envisalink-webapp.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now envisalink-webapp
# Logs:  journalctl -u envisalink-webapp -f

[Unit]
Description=EnvisaLink webapp (alarm panel web UI)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=pi
WorkingDirectory=/home/pi/shared/Workspace/Claude/EnvisaLink/envisalink-webapp
ExecStart=/home/pi/shared/Workspace/Claude/EnvisaLink/envisalink-webapp/venv/bin/python app.py
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
