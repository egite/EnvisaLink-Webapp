#!/bin/sh /etc/rc.common
# OpenWrt procd init script for the EnvisaLink TPI proxy.
#
# Install:
#   opkg update && opkg install python3-light
#   cp tpi_proxy.py /usr/bin/tpi_proxy.py && chmod +x /usr/bin/tpi_proxy.py
#   cp evl-tpi-proxy.init /etc/init.d/evl-tpi-proxy && chmod +x /etc/init.d/evl-tpi-proxy
#   cp tpi-proxy.conf.example /etc/tpi-proxy.conf    # then edit it (chmod 600)
#   /etc/init.d/evl-tpi-proxy enable
#   /etc/init.d/evl-tpi-proxy start
# Logs: logread -e tpi-proxy

USE_PROCD=1
START=95
STOP=10

start_service() {
    [ -f /etc/tpi-proxy.conf ] && . /etc/tpi-proxy.conf

    procd_open_instance
    procd_set_param command /usr/bin/python3 /usr/bin/tpi_proxy.py
    procd_set_param env \
        EVL_HOST="${EVL_HOST}" \
        EVL_PORT="${EVL_PORT:-4025}" \
        EVL_PASS="${EVL_PASS}" \
        LISTEN_HOST="${LISTEN_HOST:-0.0.0.0}" \
        LISTEN_PORT="${LISTEN_PORT:-4025}" \
        CLIENT_PASS="${CLIENT_PASS}" \
        PANEL="${PANEL:-honeywell}" \
        KEEPALIVE="${KEEPALIVE:-120}"
    procd_set_param respawn
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_close_instance
}
